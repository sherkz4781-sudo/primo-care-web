# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Google (Calendar + Gmail) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained once by running: npm run get-refresh-token  (see README.md)
GOOGLE_REFRESH_TOKEN=

# The calendar/Gmail account bookings and drafts are created under.
OWNER_EMAIL=sherkz4781@gmail.com
CAL_TIMEZONE=Asia/Manila

# --- Airtable ---
# From https://airtable.com/create/tokens — needs data.records:read and data.records:write
# scope on the "Primo Care - Client Submissions" base.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=appmCR3lGulzAsCjs
AIRTABLE_TABLE_NAME=Submissions

# --- Staff & Dashboard logins ---
# Day-to-day accounts live in the "Members" Airtable table (Username, Password, Role: Admin or
# Staff), managed from /dashboard/members — not env vars. Staff role unlocks /staff only; Admin
# unlocks /staff and /dashboard.
#
# The variables below are "break-glass" fallback accounts that always work even if the Members
# table is empty, misconfigured, or Airtable is briefly unreachable. Every break-glass account
# gets full (Admin-equivalent) access. Comma-separated "username:password" pairs:
#   STAFF_USERS=owner:sOmEpAsS
STAFF_USERS=
# Legacy single-account fallback — still honored if set, in addition to STAFF_USERS above.
STAFF_USERNAME=
STAFF_PASSWORD=
# Same format, break-glass access to /dashboard specifically.
DASHBOARD_USERS=

# --- Stripe (online payments — "Pay Now" link in the billing statement email) ---
# Leave both blank to keep online payment inactive: the "Pay Now" link still shows in billing
# emails, but clicking it shows a friendly "we're still setting up online payments" page instead
# of erroring. Fill both in once you have a Stripe account to turn it on — no code changes needed.
# STRIPE_SECRET_KEY: Stripe Dashboard > Developers > API keys (use the "sk_live_..." key for real
# payments, "sk_test_..." to test with Stripe's fake card numbers first).
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: Stripe Dashboard > Developers > Webhooks > Add endpoint, pointed at
# https://<your-domain>/api/stripe/webhook, listening for the checkout.session.completed event.
# The dashboard shows a signing secret ("whsec_...") once the endpoint is created — that's this.
STRIPE_WEBHOOK_SECRET=

# --- App ---
PORT=3000
